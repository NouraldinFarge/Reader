{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reader",
  "version": "0.1.0-alpha.4",
  "identifier": "app.reader.localfirst",
  "build": {
    "beforeDevCommand": "node scripts/serve.mjs",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Reader",
        "width": 1440,
        "height": 940,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "A local-first reading library",
    "longDescription": "Read EPUB, PDF, text, and unprotected audio in a focused local library.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
